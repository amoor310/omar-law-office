{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api-server": {
      "root": "artifacts/api-server",
      "framework": "express"
    },
    "omar-law-office": {
      "root": "artifacts/omar-law-office",
      "framework": "vite",
      "bindings": [
        { "type": "service", "service": "api-server", "format": "url", "env": "API_URL" }
      ]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api-server" } },
    { "source": "/(.*)", "destination": { "service": "omar-law-office" } }
  ]
}